# Optional: Your OpenAI API key for LLM generation
USER_LLM_API_KEY=your-api-key-here

# Optional: Custom OpenAI model name (default: gpt-4o-mini)
USER_LLM_MODEL=gpt-4o-mini

# Optional: Alternative OpenAI-compatible base URL (e.g. Ollama or local LLM)
# USER_LLM_BASE_URL=http://localhost:11434/v1

# Embedding settings: set to true to run 100% offline without any model download
USE_HASH_EMBEDDINGS=true
